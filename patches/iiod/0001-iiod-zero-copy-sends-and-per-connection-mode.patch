+/*
+ * Only one process can have a device node open. libiio disables the device's
+ * buffer through sysfs before it finds the node busy, which would stop the
+ * iiod (omnicored runs one per connection) that is streaming from it.
+ */
+static bool dev_node_busy(const struct iio_device *dev)
+{
+	char path[64];
+	int fd;
+
+	snprintf(path, sizeof(path), "/dev/%s", iio_device_get_id(dev));
+	fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+	if (fd >= 0) {
+		close(fd);
+		return false;
+	}
+
+	return errno == EBUSY;
+}
+
 static void rw_thd(struct thread_pool *pool, void *d)
 {
 	struct DevEntry *entry = d;
@@ -606,8 +766,13 @@ static void rw_thd(struct thread_pool *pool, void *d)
 					iio_channel_disable(chn);
 			}
 
-			entry->buf = iio_device_create_buffer(dev,
-					samples_count, entry->cyclic);
+			if (dev_node_busy(dev)) {
+				entry->buf = NULL;
+				errno = EBUSY;
+			} else {
+				entry->buf = iio_device_create_buffer(dev,
+						samples_count, entry->cyclic);
+			}
 			if (!entry->buf) {
 				ret = -errno;
 				IIO_ERROR("Unable to create buffer\n");
@@ -1492,6 +1657,7 @@ void interpreter(struct iio_context *ctx, int fd_in, int fd_out, bool verbose,
 	pdata.fd_in_is_socket = is_socket;
 	pdata.fd_out_is_socket = is_socket;
 	pdata.is_usb = is_usb;
+	pdata.zc_pipe[0] = pdata.zc_pipe[1] = -1;
 
 	SLIST_INIT(&pdata.thdlist_head);
 
@@ -1539,6 +1705,8 @@ void interpreter(struct iio_context *ctx, int fd_in, int fd_out, bool verbose,
 	for (i = 0; i < iio_context_get_devices_count(ctx); i++)
 		close_dev_helper(&pdata, iio_context_get_device(ctx, i));
 
+	zc_pipe_close(&pdata);
+
 #if WITH_AIO
 	if (use_aio) {
 		io_destroy(pdata.aio_ctx);
