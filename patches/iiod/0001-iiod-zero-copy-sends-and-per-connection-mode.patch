+/*
+ * True if [ptr, ptr + len) lies in an mmap of an IIO buffer block (high-speed
+ * local backend). Only such memory may be handed to a socket by reference: the
+ * kernel keeps a block away from the DMA until the network stack has released
+ * its pages. Other buffers are reused as soon as send_data() returns.
+ */
+static bool is_iio_block(const void *ptr, size_t len)
+{
+	uintptr_t start = (uintptr_t) ptr, end = start + len;
+	bool found = false;
+	char line[512];
+	FILE *f;
+
+	f = fopen("/proc/self/maps", "re");
+	if (!f)
+		return false;
+
+	while (!found && fgets(line, sizeof(line), f)) {
+		unsigned long lo, hi;
+		int path = 0;
+
+		if (sscanf(line, "%lx-%lx %*s %*s %*s %*s %n", &lo, &hi, &path) == 2
+		    && path && start >= lo && end <= hi)
+			found = !strncmp(line + path, "/dev/iio:", 9);
+	}
+
+	fclose(f);
+	return found;
+}
+
+static void zc_pipe_close(struct parser_pdata *pdata)
+{
+	if (pdata->zc_pipe[0] >= 0) {
+		close(pdata->zc_pipe[0]);
+		close(pdata->zc_pipe[1]);
+		pdata->zc_pipe[0] = pdata->zc_pipe[1] = -1;
+	}
+}
+
+/*
+ * Send an mmapped IIO block without copying it: vmsplice() its pages into a
+ * pipe, then splice() the pipe into the socket. Returns -ENOTSUP when the
+ * kernel can't do it (pages not insertable, nothing sent yet), so the caller
+ * falls back to write_all().
+ */
+static ssize_t splice_all_unsafe(struct parser_pdata *pdata, const void *src, size_t len)
+{
+	uintptr_t ptr = (uintptr_t) src;
+	struct pollfd pfd[2];
+	ssize_t ret;
+
+	if (pdata->zc_pipe[0] < 0) {
+		if (pipe2(pdata->zc_pipe, O_CLOEXEC | O_NONBLOCK))
+			return -ENOTSUP;
+		fcntl(pdata->zc_pipe[1], F_SETPIPE_SZ, 1 << 20);
+	}
+
+	pfd[0].fd = pdata->fd_out;
+	pfd[0].events = POLLOUT;
+	pfd[1].fd = thread_pool_get_poll_fd(pdata->pool);
+	pfd[1].events = POLLIN;
+
+	while (len) {
+		struct iovec iov = { (void *) ptr, len };
+		ssize_t in = vmsplice(pdata->zc_pipe[1], &iov, 1, 0);
+
+		if (in < 0) {
+			ret = (ptr == (uintptr_t) src) ? -ENOTSUP : -errno;
+			goto err;
+		}
+		ptr += in;
+		len -= in;
+
+		while (in) {
+			pfd[0].revents = pfd[1].revents = 0;
+			poll_nointr(pfd, 2);
+
+			/* Got STOP event, or client closed the socket: EOF */
+			if (pfd[1].revents & POLLIN || pfd[0].revents & POLLHUP) {
+				ret = 0;
+				goto err;
+			}
+			if (pfd[0].revents & POLLERR) {
+				ret = -EIO;
+				goto err;
+			}
+			if (!(pfd[0].revents & POLLOUT))
+				continue;
+
+			ret = splice(pdata->zc_pipe[0], NULL, pdata->fd_out, NULL, in,
+				     SPLICE_F_MOVE | SPLICE_F_NONBLOCK |
+				     (len ? SPLICE_F_MORE : 0));
+			if (ret < 0) {
+				if (errno == EAGAIN || errno == EINTR)
+					continue;
+				ret = -errno;
+				goto err;
+			}
+			in -= ret;
+		}
+	}
+
+	return ptr - (uintptr_t) src;
+
+err:
+	/* Drop whatever is left in the pipe, it references the block. */
+	zc_pipe_close(pdata);
+	return ret;
+}
+
+/*
+ * Unlike send(MSG_NOSIGNAL), splice() into a closed socket raises SIGPIPE, and
+ * iiod's handler would stop the whole server: block it and discard it here.
+ */
+static ssize_t splice_all(struct parser_pdata *pdata, const void *src, size_t len)
+{
+	struct timespec zero = { 0, 0 };
+	sigset_t set, old;
+	ssize_t ret;
+
+	sigemptyset(&set);
+	sigaddset(&set, SIGPIPE);
+	pthread_sigmask(SIG_BLOCK, &set, &old);
+	ret = splice_all_unsafe(pdata, src, len);
+	if (ret == -EPIPE)
+		while (sigtimedwait(&set, NULL, &zero) == SIGPIPE);
+	pthread_sigmask(SIG_SETMASK, &old, NULL);
+	return ret;
+}
