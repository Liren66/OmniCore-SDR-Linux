+/*
+ * Block pages are mapped to userspace with vm_insert_page(), so iiod can pass
+ * them to a socket with vmsplice() + splice() instead of copying them. The
+ * network stack then keeps page references until the data has been
+ * acknowledged, and the block must neither be refilled by the DMA nor freed
+ * before they are gone. Mapping and unmapping change the refcount and the
+ * mapcount together, so any other reference shows up here.
+ */
+static bool iio_dma_buffer_block_busy(struct iio_dma_buffer_block *block)
+{
+	unsigned int i, n = PAGE_ALIGN(block->block.size) >> PAGE_SHIFT;
+
+	for (i = 0; i < n; i++) {
+		struct page *page = nth_page(block->pages, i);
+
+		if (page_count(page) != block->page_ref_base + page_mapcount(page))
+			return true;
+	}
+
+	return false;
+}
+
+static void iio_dma_buffer_defer_release(struct iio_dma_buffer_block *block);
+
 static void iio_buffer_block_release(struct kref *kref)
 {
 	struct iio_dma_buffer_block *block = container_of(kref,
@@ -101,6 +127,11 @@ static void iio_buffer_block_release(struct kref *kref)
 
 	WARN_ON(block->state != IIO_BLOCK_STATE_DEAD);
 
+	if (iio_dma_buffer_block_busy(block)) {
+		iio_dma_buffer_defer_release(block);
+		return;
+	}
+
 	dma_free_coherent(block->queue->dev, PAGE_ALIGN(block->block.size),
 					block->vaddr, block->phys_addr);
 
@@ -125,6 +156,10 @@ static void iio_buffer_block_put(struct iio_dma_buffer_block *block)
 static LIST_HEAD(iio_dma_buffer_dead_blocks);
 static DEFINE_SPINLOCK(iio_dma_buffer_dead_blocks_lock);
 
+static void iio_dma_buffer_cleanup_worker(struct work_struct *work);
+static DECLARE_DELAYED_WORK(iio_dma_buffer_cleanup_work,
