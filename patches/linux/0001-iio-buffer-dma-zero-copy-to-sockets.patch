@@ -304,6 +354,13 @@ static void iio_dma_buffer_submit_block(struct iio_dma_buffer_queue *queue,
 	if (!queue->ops)
 		return;
 
+	if (iio_dma_buffer_block_busy(block)) {
+		block->state = IIO_BLOCK_STATE_QUEUED;
+		list_add_tail(&block->head, &queue->deferred);
+		schedule_delayed_work(&queue->deferred_work, 1);
+		return;
+	}
+
 	block->state = IIO_BLOCK_STATE_ACTIVE;
 	iio_buffer_block_get(block);
 	ret = queue->ops->submit(queue, block);
@@ -322,6 +379,27 @@ static void iio_dma_buffer_submit_block(struct iio_dma_buffer_queue *queue,
 	}
 }
 
+static void iio_dma_buffer_deferred_worker(struct work_struct *work)
+{
+	struct iio_dma_buffer_queue *queue = container_of(to_delayed_work(work),
+		struct iio_dma_buffer_queue, deferred_work);
+	struct iio_dma_buffer_block *block, *_block;
+
+	mutex_lock(&queue->lock);
+	list_for_each_entry_safe(block, _block, &queue->deferred, head) {
+		if (queue->active && iio_dma_buffer_block_busy(block))
+			continue;
+		list_del(&block->head);
+		if (queue->active)
+			iio_dma_buffer_submit_block(queue, block);
+		else
+			list_add_tail(&block->head, &queue->incoming);
+	}
+	if (!list_empty(&queue->deferred))
+		schedule_delayed_work(&queue->deferred_work, 1);
+	mutex_unlock(&queue->lock);
+}
