 		queue->blocks[i]->state = IIO_BLOCK_STATE_DEAD;
@@ -805,13 +884,26 @@ int iio_dma_buffer_mmap(struct iio_buffer *buffer,
 	vma->vm_pgoff = 0;
 
 	vma->vm_flags |= VM_DONTEXPAND | VM_DONTDUMP;
+	vma->vm_page_prot = dma_pgprot(queue->dev, vma->vm_page_prot, 0);
+
+	/*
+	 * Same attributes as dma_mmap_coherent(), but inserting the pages
+	 * instead of remapping the PFNs lets userspace vmsplice() them (see
+	 * iio_dma_buffer_block_busy()).
+	 */
+	for (i = 0; i < (vma->vm_end - vma->vm_start) >> PAGE_SHIFT; i++) {
+		int ret = vm_insert_page(vma, vma->vm_start + i * PAGE_SIZE,
+					 nth_page(block->pages, i));
+		if (ret)
+			return ret;
+	}
+
 	vma->vm_ops = &iio_dma_buffer_vm_ops;
 	vma->vm_private_data = block;
 
 	vma->vm_ops->open(vma);
 
-	return dma_mmap_coherent(queue->dev, vma, block->vaddr,
-		block->phys_addr, vma->vm_end - vma->vm_start);
+	return 0;
 }
 EXPORT_SYMBOL_GPL(iio_dma_buffer_mmap);
 
@@ -875,6 +967,8 @@ int iio_dma_buffer_init(struct iio_dma_buffer_queue *queue,
 
 	INIT_LIST_HEAD(&queue->incoming);
 	INIT_LIST_HEAD(&queue->outgoing);
+	INIT_LIST_HEAD(&queue->deferred);
+	INIT_DELAYED_WORK(&queue->deferred_work, iio_dma_buffer_deferred_worker);
 
 	mutex_init(&queue->lock);
 	spin_lock_init(&queue->list_lock);
@@ -897,6 +991,7 @@ EXPORT_SYMBOL_GPL(iio_dma_buffer_init);
  */
 void iio_dma_buffer_exit(struct iio_dma_buffer_queue *queue)
 {
+	cancel_delayed_work_sync(&queue->deferred_work);
 	mutex_lock(&queue->lock);
 	queue->ops = NULL;
 	mutex_unlock(&queue->lock);
@@ -913,6 +1008,7 @@ EXPORT_SYMBOL_GPL(iio_dma_buffer_exit);
  */
 void iio_dma_buffer_release(struct iio_dma_buffer_queue *queue)
 {
+	cancel_delayed_work_sync(&queue->deferred_work);
 	mutex_destroy(&queue->lock);
 }
 EXPORT_SYMBOL_GPL(iio_dma_buffer_release);
