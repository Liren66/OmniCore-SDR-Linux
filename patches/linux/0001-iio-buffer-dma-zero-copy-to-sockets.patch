-	schedule_work(&iio_dma_buffer_cleanup_work);
+	schedule_delayed_work(&iio_dma_buffer_cleanup_work, 0);
 }
 
 /*
@@ -182,6 +228,10 @@ static struct iio_dma_buffer_block *iio_dma_buffer_alloc_block(
 		return NULL;
